# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed. Restart the server after changing any value.

# --- Core Django ---
# Set DEBUG=False in production.
DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Google OAuth (required for "Continue with Google" / team login) ---
# Create an OAuth 2.0 Client ID in the Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Application type: Web application.
# Authorized redirect URI (add one per host you use), e.g. for local dev:
#   http://127.0.0.1:8000/accounts/google/login/callback/
# Leaving these as PLACEHOLDER_* disables Google login and shows a notice
# on the team login page instead of Google's "invalid_client" error.
GOOGLE_CLIENT_ID=PLACEHOLDER_CLIENT_ID
GOOGLE_CLIENT_SECRET=PLACEHOLDER_CLIENT_SECRET

# --- Email (Gmail SMTP) ---
EMAIL_HOST_USER=placeholder.parallax@gmail.com
EMAIL_HOST_PASSWORD=PLACEHOLDER_APP_PASSWORD

# --- Event / registration ---
REQUIRE_INVOICE_VERIFICATION=False
EVENT_HUB_URL=https://eventhub.example.com/parallax
